{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=autohub_db;Username=autohub_user;Password=autohub_pass"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "AutoHubAPI",
    "Audience": "AutoHubClient",
    "ExpiryHours": 8
  },
  "SeedAdmin": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "WhatsApp": {
    "Enabled": true,
    "PhoneNumber": "",
    "MessageTemplate": "Hola, me interesa el {make} {model} {year} con referencia {reference}. ¿Podrían darme más información?"
  },
  "Leads": {
    "IpHashSalt": ""
  },
  "SeedCatalog": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
