@AutoHub.Api_HostAddress = http://localhost:5116

### Login (admin de desarrollo: admin@autohub.local / Admin123!)
# @name login
POST {{AutoHub.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@autohub.local",
  "password": "Admin123!"
}

###

@token = {{login.response.body.$.token}}

### Usuario actual (requiere Bearer)
GET {{AutoHub.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
Accept: application/json

### Branding público (sin auth)
GET {{AutoHub.Api_HostAddress}}/api/settings/branding
Accept: application/json

### Actualizar branding (requiere rol Admin)
PUT {{AutoHub.Api_HostAddress}}/api/settings/branding
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "appName": "Mi Tienda",
  "primaryLight": "#71DDFF",
  "primary": "#4DC4FF",
  "primaryDark": "#45B0E5"
}

### Listar vehículos (requiere auth)
GET {{AutoHub.Api_HostAddress}}/api/vehicles?page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

### Crear vehículo (requiere auth)
# @name createVehicle
POST {{AutoHub.Api_HostAddress}}/api/vehicles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vin": "1HGCM82633A123456",
  "make": "Toyota",
  "model": "Corolla",
  "year": 2022,
  "price": 250000,
  "mileage": 15000,
  "transmission": "Automática",
  "fuelType": "Gasolina",
  "description": "Seminuevo en excelente estado"
}

###

@vehicleId = {{createVehicle.response.body.$.id}}

### Detalle de vehículo (requiere auth)
GET {{AutoHub.Api_HostAddress}}/api/vehicles/{{vehicleId}}
Authorization: Bearer {{token}}
Accept: application/json

###
