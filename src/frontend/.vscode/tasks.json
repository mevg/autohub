  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: serve (pnpm)",
      "type": "shell",
      "command": "pnpm start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building...",
          "endsPattern": "bundle generation (complete|failed)"
        }
      }
    }
  ]
}
