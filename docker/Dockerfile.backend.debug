# Backend para DEPURAR desde VS Code (no usar en prod).
# Igual que Dockerfile.backend pero con vsdbg para el attach de coreclr.
# Mantener sincronizada la etapa de publish con Dockerfile.backend.
# Contexto de build: raíz del repo.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/backend/ ./src/backend/
RUN dotnet publish src/backend/src/Api/AutoHub.Api.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --from=build /app/publish .
RUN mkdir -p /app/wwwroot /app/logs /vsdbg \
    && apt-get update \
    && apt-get install -y --no-install-recommends procps unzip curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
    && chown -R app:app /app/wwwroot /app/logs /vsdbg
# Sin USER app: el attach de VS Code (docker exec) corre como root.
ENTRYPOINT ["dotnet", "AutoHub.Api.dll"]
