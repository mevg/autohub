# Frontend AutoHub (Angular 22 + pnpm). Contexto de build: raíz del repo.
#   docker build -f docker/Dockerfile.frontend --build-arg VERSION=1.2.3 .
FROM node:22 AS build
RUN corepack enable && corepack prepare pnpm@11.5.2 --activate
WORKDIR /app
COPY src/frontend/package.json src/frontend/pnpm-lock.yaml src/frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY src/frontend/ ./
# Igual que el CI (frontend-ci.yml): la versión viaja en environment.prod.ts.
ARG VERSION=0.0.0
RUN echo "export const environment = { production: true, version: '${VERSION}' };" \
    > src/environments/environment.prod.ts
RUN pnpm build --configuration=production

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
