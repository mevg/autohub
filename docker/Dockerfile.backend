# Backend AutoHub (.NET 10). Contexto de build: raíz del repo.
#   docker build -f docker/Dockerfile.backend .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/backend/ ./src/backend/
RUN dotnet publish src/backend/src/Api/AutoHub.Api.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --from=build /app/publish .
# wwwroot (uploads) y logs los crea la app al arrancar; se dejan con dueño
# app para que funcionen con el volumen nombrado del compose.
RUN mkdir -p /app/wwwroot /app/logs && chown -R app:app /app/wwwroot /app/logs
USER app
ENTRYPOINT ["dotnet", "AutoHub.Api.dll"]
