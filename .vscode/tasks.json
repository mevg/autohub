{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build backend",
      "type": "shell",
      "command": "dotnet build AutoHub.slnx -c Debug",
      "options": { "cwd": "${workspaceFolder}/src/backend" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: watch api",
      "type": "shell",
      "command": "dotnet watch run --project src/Api --launch-profile http",
      "options": {
        "cwd": "${workspaceFolder}/src/backend",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      },
      "isBackground": true,
      "presentation": { "reveal": "always" },
      "problemMatcher": {
        "owner": "dotnet-watch",
        "pattern": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building...",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "dotnet: test backend",
      "type": "shell",
      "command": "dotnet test AutoHub.slnx -c Debug",
      "options": { "cwd": "${workspaceFolder}/src/backend" },
      "group": "test",
      "presentation": { "reveal": "always" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "frontend: serve",
      "type": "shell",
      "command": "pnpm start",
      "options": { "cwd": "${workspaceFolder}/src/frontend" },
      "isBackground": true,
      "presentation": { "reveal": "always" },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building...",
          "endsPattern": "bundle generation (complete|failed)"
        }
      }
    },
    {
      "label": "frontend: test",
      "type": "shell",
      "command": "pnpm test:ci",
      "options": { "cwd": "${workspaceFolder}/src/frontend" },
      "group": "test",
      "presentation": { "reveal": "always" },
      "problemMatcher": "$msCompile"
    }
  ]
}
