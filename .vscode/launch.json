{
  // Requiere: .NET 10 SDK, Node 22 + pnpm, Postgres local
  // (docker o Host=localhost:5432 con autohub_db/autohub_user).
  // El front usa proxy.conf.json -> http://localhost:5116 (ver src/frontend/proxy.conf.json).
  //
  // Docker: tasks "docker: up" (stack completo) o "docker: up api+db (debug)".
  // Para depurar el backend en contenedor se necesita la extensión Docker
  // (pickRemoteProcess) y la imagen debug (vsdbg), que levanta el task de debug.
  // Flujo debug: 1) task "docker: up api+db (debug)", 2) F5
  // "Docker: debug (API en contenedor + Angular local)".
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: AutoHub API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build backend",
      "program": "${workspaceFolder}/src/backend/src/Api/bin/Debug/net10.0/AutoHub.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/backend/src/Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "launchBrowser": { "enabled": false }
    },
    {
      "name": ".NET: attach backend (Docker)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "autohub-backend-1"],
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": true,
        "debuggerPath": "/vsdbg/vsdbg"
      },
      "sourceFileMap": { "/src/backend": "${workspaceFolder}/src/backend" }
    },
    {
      "name": "Angular: serve + debug",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src/frontend/src",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + Angular",
      "configurations": [".NET: AutoHub API", "Angular: serve + debug"]
    },
    {
      "name": "Docker: debug (API en contenedor + Angular local)",
      "configurations": [".NET: attach backend (Docker)", "Angular: serve + debug"]
    }
  ]
}
